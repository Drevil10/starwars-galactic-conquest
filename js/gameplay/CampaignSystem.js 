// js/gameplay/CampaignSystem.js
// Creación y control de campañas según la facción seleccionada.

class CampaignSystemClass {
    constructor() {
        this.initialized = false;
    }

    init() {
        if (this.initialized) return;

        if (typeof FactionData === 'undefined') {
            console.error(
                'CampaignSystem: FactionData no está disponible. ' +
                'Comprueba que js/data/factions-data.js se cargue antes.'
            );
            return;
        }

        if (typeof GameState === 'undefined') {
            console.error(
                'CampaignSystem: GameState no está disponible. ' +
                'Comprueba que js/core/GameState.js se cargue antes.'
            );
            return;
        }

        this.initialized = true;
        console.log('CampaignSystem: Inicializado.');
    }

    getFactions() {
        if (typeof FactionData === 'undefined') {
            return [];
        }

        return Object.values(FactionData);
    }

    getFaction(factionId) {
        if (typeof FactionData === 'undefined') {
            return null;
        }

        return FactionData[factionId] || null;
    }

    hasActiveCampaign() {
        if (typeof GameState === 'undefined') {
            return false;
        }

        const state = GameState.getState();

        return Boolean(
            state.selectedFaction &&
            Array.isArray(state.controlledPlanets) &&
            state.controlledPlanets.length > 0
        );
    }

    startCampaign(factionId) {
        if (!this.initialized) {
            this.init();
        }

        const faction = this.getFaction(factionId);

        if (!faction) {
            console.error(
                'CampaignSystem: Facción inválida o no encontrada.',
                factionId
            );

            return {
                success: false,
                error: 'Facción no válida.'
            };
        }

        if (typeof GameState === 'undefined') {
            return {
                success: false,
                error: 'GameState no está disponible.'
            };
        }

        // Reiniciar cualquier estado anterior antes de crear una campaña nueva.
        GameState.reset();

        // Crear el estado inicial de campaña.
        GameState.setState({
            selectedFaction: faction.id,
            controlledPlanets: [...faction.startingPlanets],
            fleets: faction.startingFleets.map(fleet => ({
                ...fleet,
                ships: { ...fleet.ships }
            })),
            buildings: {},
            researchedTech: [],
            activeEvents: [],
            currentMission: {
                ...faction.startingMission
            },
            gameState: 'playing',
            screen: 'map',
            turn: 1,
            campaignStartedAt: Date.now()
        });

        // Aplicar recursos tras el reset.
        GameState.setResource(
            'credits',
            faction.startingResources.credits
        );

        GameState.setResource(
            'minerals',
            faction.startingResources.minerals
        );

        GameState.setResource(
            'energy',
            faction.startingResources.energy
        );

        GameState.setResource(
            'research',
            faction.startingResources.research
        );

        console.log(
            `CampaignSystem: Campaña iniciada con ${faction.name}.`,
            {
                faction: faction.id,
                capital: faction.capital,
                planets: faction.startingPlanets,
                fleets: faction.startingFleets
            }
        );

        return {
            success: true,
            faction,
            mission: { ...faction.startingMission },
            capital: faction.capital,
            controlledPlanets: [...faction.startingPlanets],
            fleets: faction.startingFleets.map(fleet => ({
                ...fleet,
                ships: { ...fleet.ships }
            }))
        };
    }

    getCampaignSummary() {
        if (typeof GameState === 'undefined') {
            return null;
        }

        const state = GameState.getState();
        const faction = this.getFaction(state.selectedFaction);

        if (!faction) {
            return null;
        }

        return {
            faction: {
                id: faction.id,
                name: faction.name,
                shortName: faction.shortName,
                capital: faction.capital,
                color: faction.color,
                icon: faction.icon
            },
            turn: state.turn,
            resources: GameState.getResources(),
            controlledPlanets: [...state.controlledPlanets],
            fleets: [...state.fleets],
            mission: state.currentMission || null
        };
    }

    restartCampaign() {
        if (typeof GameState === 'undefined') {
            return false;
        }

        GameState.reset();

        console.log('CampaignSystem: Campaña reiniciada.');

        return true;
    }
}

window.CampaignSystem = new CampaignSystemClass();
